	if (!started) {
		return;
	}
	long mappedHunger = map(hunger, 0, 100, 0, 10);
	long mappedHappiness = map(happiness, 0, 100, 0, 10);
	long mappedHealth = map(health, 0, 100, 0, 10);
	Serial.println(mappedHunger);
	Serial.println(mappedHappiness);
	Serial.println(mappedHealth);
	display.drawBitmap(0, 0, icons[0], 16, 16, WHITE);
	display.drawRect(barXPosition, 0, 10, barYSize, WHITE);
	display.fillRect(barXPosition, 0, mappedHappiness, barYSize, WHITE);
	display.drawBitmap(barXPosition * 3, 0, icons[1], 16, 16, WHITE);
	display.drawRect(barXPosition * 4, 0, 10, barYSize, WHITE);
	display.fillRect(barXPosition * 4, 0, mappedHealth, barYSize, WHITE);
	display.drawBitmap(barXPosition * 6 - 1, 0, icons[2], 16, 16, WHITE);
	display.drawRect(barXPosition * 7 - 1, 0, 10, barYSize, WHITE);
	display.fillRect(barXPosition * 7 - 1, 0, mappedHunger, barYSize, WHITE);
}

void checkButtons(long currentMillis, bool pressed1, bool pressed2, bool pressed3) {
	if (dead && (pressed1 || pressed2 || pressed3)) {
		dead = false;
		hunger = 100;
		happiness = 100;
		health = 100;
		discipline = 100;
		weight = 1;
		age = 0;
		poopometer = 0;
	}

	if (sequenceStep != 0 && currentMillis - lastButtonPressed > TIMEOUT) {
		sequenceStep = 0;
	}

	if (sequenceStep == 0 && pressed2 && !isMenuActive) {
		isMenuActive = true;
	}

	if (isMenuActive) {
		if (pressed1) {
			menuItem -= 1;
			if (menuItem <= -1) {
				menuItem = 5;
			}
		}
		if (pressed3) {
			menuItem += 1;
			if (menuItem >= 6) {
				menuItem = 0;
			}
		}
		if (pressed2 && menuItem == 0) {
			menuItem = 1;
			isMenuActive = false;
			shouldApply = false;
			menuButtonPressed = false;
			return;
		}
		if (pressed2 && menuButtonPressed) {
			shouldApply = true;
			menuButtonPressed = false;
		}
		menuButtonPressed = true;
		return;
	}

	if (sequenceStep != 2 && pressed3 && !isMenuActive) {
		Serial.println("Hambre: ");
		Serial.println(hunger);
		Serial.println("Felicidad: ");
		Serial.println(happiness);
		Serial.println("Salud: ");
		Serial.println(health);
		Serial.println("Disciplina: ");
		Serial.println(discipline);
		Serial.println("Peso: ");
		Serial.println(weight);
		Serial.println("Edad: ");
		Serial.println(age);
		Serial.println("Caca: ");
		Serial.println(poopometer);
	}

	switch (sequenceStep) {
		case 0:
			if (pressed1) {
				Serial.println("Boton 1");
				sequenceStep = 1;
				lastButtonPressed = currentMillis;
			}
			break;

		case 1:
			if (pressed2) {
				Serial.println("Boton 2");
				sequenceStep = 2;
				lastButtonPressed = currentMillis;
			} else if (pressed3) {
				sequenceStep = 0;
			}
			break;

		case 2:
			if (pressed3) {
				Serial.println("Boton 3");
				Serial.println("Secuencia correcta");
				soTheme();

				sequenceStep = 0;
			}

			else if (pressed1 || pressed2) {
				sequenceStep = 0;
			}
			break;
	}
}

