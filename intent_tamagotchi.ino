}

int countPoops() {
	int poopsCnt = 0;
	for (int i = 0; i < 3; i++) {
		if (poops[i] > 0) {
			++poopsCnt;
		}
	}
	return poopsCnt;
}

void playSound(const int* notes, const int* durations, int length) {
	for (int i = 0; i < length; i++) {
		if (notes[i] != 0)
			tone(BUZZZER_PIN, notes[i], durations[i]);

		delay(durations[i] + 8);
		noTone(BUZZZER_PIN);
	}
}

void soTheme() {
	for (int thisNote = 0; thisNote < notesSoTheme * 2; thisNote = thisNote + 2) {

		// calculates the duration of each note
		divider = melodySoTheme[thisNote + 1];
		if (divider > 0) {
			// regular note, just proceed
			noteDuration = (wholenote) / divider;
		} else if (divider < 0) {
			// dotted notes are represented with negative durations!!
			noteDuration = (wholenote) / abs(divider);
			noteDuration *= 1.5;  // increases the duration in half for dotted notes
		}

		// we only play the note for 90% of the duration, leaving 10% as a pause
		tone(BUZZZER_PIN, melodySoTheme[thisNote], noteDuration * 0.9);

		// Wait for the specief duration before playing the next note.
		delay(noteDuration);

		// stop the waveform generation before the next note.
		noTone(BUZZZER_PIN);
	}
}

void updateState() {
	age += 0.0000025;
	if (hunger <= 0.00001 || health <= 0.00001) {
		dead = true;
	}
	if (discipline - 0.0001 > 0) {
		discipline -= 0.0001;
	}
	if (sleeping) {
		hunger -= 0.00005;
		poopometer += 0.00005;
		if (happiness - 0.0001 > 0) {
			happiness -= 0.0001;
		}
		health -= 0.00005 + countPoops() * 0.0001;
		return;
	}
	hunger -= 0.00025;
	poopometer += 0.00025;
	if (happiness - 0.0002 > 0) {
		happiness -= 0.0002;
	}
	health -= 0.0001 + countPoops() * 0.0001;
	if (poopometer >= 10) {
		poopometer = countPoops();
		poops[(int)round(poopometer)] = random(20, display.width() + 32);
		poopometer = 0;
	}
}


