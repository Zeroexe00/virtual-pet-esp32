void eggAnimation(long currentMillis) {

	if (currentMillis - lastEggFrameMillis >= EGG_FRAME_INTERVAL) {

		lastEggFrameMillis = currentMillis;

		eggFrame++;

		if (eggFrame >= 4) {
			eggFrame = 0;
		}
	}

	display.drawBitmap(
	  0,
	  0,
	  eggAnim[eggFrame],
	  128,
	  64,
	  WHITE);

	display.display();
}

