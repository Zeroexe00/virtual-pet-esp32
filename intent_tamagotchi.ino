}

void sleepingDraw(unsigned long currentMillis) {
	if ((currentMillis / 500) % 2 == 0) {
		display.setCursor(walkXPos, 45);
		display.print(F("Z"));
		display.setCursor(walkXPos, 48);
		display.print(F("z"));
	}
}

void walkDrawAndMovement() {
	if (sleeping) {
		return;
	}
	const unsigned char** stepToDraw;
	if (toRight) {
		walkXPos += 1;
		grassXPos += 2;
		if (walkXPos >= 112) {
			toRight = false;
		}
		stepToDraw = epd_bitmap_allArray;
	} else {
		walkXPos -= 1;
		grassXPos -= 2;
		if (walkXPos <= 0) {
			toRight = true;
		}
		stepToDraw = epd_bitmap_allArray_reversed;
	}
	display.drawBitmap(walkXPos, 49, stepToDraw[walkPos], 20, 16, WHITE);
	walkPos += 1;
}

void animationPetState(unsigned long currentMillis, bool pressed1) {
	if (isMenuActive) {
		return;
	}
	if (!started && !pressed1) {
		eggAnimation(currentMillis);
		return;
	}

	backgroundDraw();
	if (pressed1 && !started) {
		started = true;
		petAnimation();
	}

	if (walkPos >= 5) {
		walkPos = 0;
	}

	if (currentMillis - lastWalkTime >= INTERVAL_WALK) {
		lastWalkTime = currentMillis;
		frontFace = !frontFace;
	}

	if (sleeping) {
		sleepingDraw(currentMillis);
	}
	if (frontFace) {
		display.drawBitmap(walkXPos, 49, epd_bitmap_pet_stage_1_happy, 20, 16, WHITE);
		display.display();
		return;
	}
	walkDrawAndMovement();
	display.display();
}

void drawMenu(unsigned long currentMillis) {
	display.clearDisplay();
	display.drawBitmap(0, 24, epd_bitmap_arrow_left, 8, 16, WHITE);
	display.drawBitmap(120, 24, epd_bitmap_arrow_right, 8, 16, WHITE);
	int heightItem = 22;
	if ((currentMillis / 500) % 2 == 0) {
		heightItem = 20;
	}
	display.drawBitmap(56, heightItem, epd_bitmap_menu_icons[menuItem], 32, 32, WHITE);
	display.display();
}

void actionMenu(unsigned long currentMillis) {
	if (!isMenuActive) {
		return;
	}
	if (shouldApply) {
		if (menuItem == 1) {
			health += 10;
			hunger += 15;
		}
		if (menuItem == 2) {
			health -= 2;
			hunger += 10;
		}
		if (menuItem == 3) {
			health += 10;
			hunger += 20;
		}
		if (menuItem == 4) {
			sleeping = !sleeping;
		}
		if (menuItem == 5) {
			poops[0] = 0;
			poops[1] = 0;
			poops[2] = 0;
		}
		menuItem = 1;
		shouldApply = false;
		menuButtonPressed = false;
		isMenuActive = false;
	}
	drawMenu(currentMillis);
}

void setup() {
	Serial.begin(115200);
	Wire.begin();

	if (!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
		Serial.println(F("SSD1306 allocation failed"));
		for (;;)
			;
	}

	pinMode(buttonPin, INPUT_PULLUP);
	pinMode(buttonPin2, INPUT_PULLUP);
	pinMode(buttonPin3, INPUT_PULLUP);
	splashScreen();
}

void loop() {
	unsigned long currentMillis = millis();

	bool pressed1 = (lastB1 == HIGH && digitalRead(buttonPin) == LOW);
	bool pressed2 = (lastB2 == HIGH && digitalRead(buttonPin2) == LOW);
	bool pressed3 = (lastB3 == HIGH && digitalRead(buttonPin3) == LOW);

	lastB1 = digitalRead(buttonPin);
	lastB2 = digitalRead(buttonPin2);
	lastB3 = digitalRead(buttonPin3);

	display.clearDisplay();

	checkButtons(currentMillis, pressed1, pressed2, pressed3);

	if (dead) {
		display.clearDisplay();
		display.setTextSize(1);
		display.setTextColor(WHITE);
		display.setCursor(0, centerY);
		display.println("La mascota ha muerto");
		if ((currentMillis / 500) % 2 == 0) {
			display.setCursor(0, centerY + 10);
			display.println("- presiona un boton -");
		}
		display.display();
		return;
	}

	updateState();
	drawStatuses();
	actionMenu(currentMillis);
	animationPetState(currentMillis, pressed1);
}
